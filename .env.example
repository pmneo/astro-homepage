# Your PayPal business email or Merchant ID — enables the "buy me a beer" donate button.
# Leave empty to hide the button.
NEXT_PUBLIC_PAYPAL_BUSINESS=

# Shared secret for GET /api/cache/evict?secret=...&namespace=images|hips — lets you clear the
# cached AstroBin images (or HiPS tiles) without SSH/redeploying. Leave empty to disable the route
# entirely (404).
CACHE_EVICT_SECRET=
